import requests

# 1. Адрес API (публичный сервис)
url = "https://jsonplaceholder.typicode.com/posts"

# 2. Отправляем GET-запрос
response = requests.get(url)

# Проверяем, что сервер ответил успешно (код 200)
if response.status_code == 200:
    # 3. Превращаем ответ в удобный формат (список словарей)
    posts = response.json()
    
    # 4. Берем первые 5 постов (срез [:5]) и выводим
    print("--- Заголовки и тела первых 5 постов ---\n")
    for post in posts[:5]:
        print(f"Заголовок: {post['title']}")
        print(f"Текст: {post['body']}")
        print("-" * 40) # Просто линия-разделитель для красоты
else:
    print("Ошибка при запросе данных")
